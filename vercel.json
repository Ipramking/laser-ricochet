{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo \"buildless static site — nothing to build\"",
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/game.manifest.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
